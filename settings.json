{
  "model": "claude-sonnet-4-6",
  "statusLine": {
    "type": "command",
    "command": "bash /home/msaraya/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gitkraken-hooks@gitkraken": false
  },
  "extraKnownMarketplaces": {
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "/home/msaraya/.claude/plugins/marketplaces/gitkraken"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "theme": "auto",
  "sandbox": {
    "enabled": true
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "autoMode": {
    "allow": ["$defaults"],
    "hard_deny": [
      "$defaults",
      "Actions that exfiltrate credentials or secrets"
    ],
    "environment": [
      "$defaults",
      "Organization: IONOS. Primary use: SRE/infrastructure tooling",
      "Source control: github.com/msaraya01"
    ]
  }
}
